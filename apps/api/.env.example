# ============================================================
# apps/api environment variables
#
# ALL of these are SERVER ONLY. This is a Next.js app that talks to
# Supabase with the service-role key — none of it may ever be prefixed
# with NEXT_PUBLIC_ or shipped to a browser/client bundle. There are
# intentionally zero NEXT_PUBLIC_* variables in this app; the mobile app
# never talks to Supabase directly (see apps/mobile/.env.example).
#
# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.
# ============================================================

# --- Supabase (SERVER ONLY) ---------------------------------------------
# Project URL and service-role key from your Supabase project settings
# (Project Settings -> API). The service-role key bypasses Row Level
# Security — treat it like a root password, never expose it to a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (SERVER ONLY) --------------------------------------------------
# Signing secret for this app's own access/refresh JWTs (see lib/auth.ts).
# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of extra allowed origins for CORS, beyond the
# built-in localhost/LAN-IP dev patterns (see middleware.ts). Only needed
# once you deploy the API somewhere with a real domain.
CORS_ALLOWED_ORIGINS=

# --- AI provider (SERVER ONLY) -------------------------------------------
# Selects which provider below is active. Currently implemented:
# "anthropic" | "omniroute" | "openrouter".
AI_PROVIDER=anthropic

# Anthropic — used for both chat (if AI_PROVIDER=anthropic) and OCR
# text-extraction (lib/ocr, always uses this key regardless of AI_PROVIDER).
ANTHROPIC_API_KEY=
# Reserved for future providers — not implemented yet (see providers/ai/index.ts).
OPENAI_API_KEY=
GEMINI_API_KEY=

# OmniRoute — self-hosted OpenAI-compatible gateway. Only reachable while
# apps/api runs on the same machine as the gateway (e.g. localhost).
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=

# OpenRouter (openrouter.ai) — hosted OpenAI-compatible gateway, works
# from any deployment. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Email (SERVER ONLY) --------------------------------------------------
# Verification codes are sent via SMTP if KP_SMTP_HOST is set, else via
# Resend if RESEND_API_KEY is set, else (non-production only) logged to
# the server console. See lib/email.ts.
KP_SMTP_HOST=
KP_SMTP_PORT=587
# 'tls' = STARTTLS (port 587, e.g. Gmail) | 'ssl' = implicit TLS (port 465)
KP_SMTP_SECURE=tls
KP_SMTP_USER=
# For Gmail, this must be a 16-character App Password, not your account
# password (requires 2-Step Verification enabled on the Google account).
KP_SMTP_PASS=
KP_EMAIL_FROM=

RESEND_API_KEY=
RESEND_FROM=

# --- Google Drive integration (SERVER ONLY, planned) ----------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Rate limiting & caching (SERVER ONLY) --------------------------------
# Upstash Redis REST credentials — used for API rate limits and caching
# weather responses. Free tier at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Weather (SERVER ONLY) -------------------------------------------------
# Free tier key at https://home.openweathermap.org/api_keys — note new keys
# can take up to ~2 hours to activate.
OPENWEATHER_API_KEY=
