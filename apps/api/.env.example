# server only — never prefix with EXPO_PUBLIC_ and never ship to the device
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# self-hosted gateway — see providers/ai/omniroute.ts
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=
RESEND_API_KEY=
# real SMTP transport — takes priority over Resend in lib/email.ts.
# KP_SMTP_SECURE: 'tls' = STARTTLS (port 587, e.g. Gmail), 'ssl' = implicit TLS (port 465)
KP_SMTP_HOST=
KP_SMTP_PORT=587
KP_SMTP_SECURE=tls
KP_SMTP_USER=
KP_SMTP_PASS=
KP_EMAIL_FROM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPENWEATHER_API_KEY=
