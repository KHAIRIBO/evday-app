# Base URL the app calls for every API request (see src/api/client.ts).
# - Web / iOS Simulator / Android Emulator: http://localhost:3000 works.
# - Physical device over Wi-Fi: use your computer's LAN IP instead —
#   "localhost" on a real device means the device itself, not your
#   computer. Find your IP with `ipconfig` (Windows) / `ifconfig` (macOS/Linux),
#   e.g. http://192.168.1.23:3000
# - Production build: your deployed apps/api URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
