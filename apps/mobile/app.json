{
  "expo": {
    "name": "khairibo",
    "slug": "khairibo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khairibo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Khairibo uses your location to show the weather for where you are."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Khairibo uses your microphone to record audio notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Khairibo uses your photo library so you can upload photos and videos to your files.",
          "cameraPermission": "Khairibo uses your camera to take photos to upload."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Khairibo saves the photos you take to your camera roll."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
